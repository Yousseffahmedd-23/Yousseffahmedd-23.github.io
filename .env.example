# MongoDB connection string
# Example for MongoDB Atlas:  mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority
# Example for local MongoDB: mongodb://localhost:27017/<dbname>
MONGO_URI=mongodb://localhost:27017/myapp

# Node environment: development | production | test
NODE_ENV=development

# Server port
PORT=5000

# JWT secret (for auth, if needed)
JWT_SECRET=your_super_secret_key_here
JWT_EXPIRE=30d
