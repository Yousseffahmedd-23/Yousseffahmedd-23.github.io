# ─────────────────────────────────────────────────────────────
#  Sabboora Backend — Environment Variables
#  Copy this file to back/.env and fill in your values.
#  NEVER commit back/.env to git.
# ─────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ──────────────────────────────────────────────────
# OPTION A — MongoDB Atlas SRV (recommended, works everywhere)
# Replace <user>, <password>, <cluster> with your Atlas values.
# Find it in Atlas → Connect → Drivers → copy the srv string.
#
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/school?retryWrites=true&w=majority

# OPTION B — Direct Atlas connection (use if SRV fails)
# MONGODB_URI=mongodb://user:pass@shard-00-00.xxx.mongodb.net:27017,shard-00-01.xxx.mongodb.net:27017,shard-00-02.xxx.mongodb.net:27017/school?tls=true&authSource=admin&retryWrites=true&w=majority

# OPTION C — Local MongoDB (if running MongoDB on your own machine)
# MONGODB_URI=mongodb://localhost:27017/school

MONGODB_URI=mongodb+srv://REPLACE_ME:REPLACE_ME@REPLACE_ME.mongodb.net/school?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────
# Use any long random string (min 32 chars). MUST be different for access/refresh.
JWT_ACCESS_SECRET=change-this-to-a-long-random-secret-min-32-chars
JWT_REFRESH_SECRET=change-this-to-a-different-long-random-secret-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── Bootstrap ─────────────────────────────────────────────────
# Used once to create the first admin account via POST /api/auth/bootstrap-admin
BOOTSTRAP_TOKEN=change-me-bootstrap

# ── CORS ─────────────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174
CORS_ORIGIN=http://localhost:5173
