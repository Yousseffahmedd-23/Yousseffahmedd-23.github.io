PORT=5000
NODE_ENV=development

# Atlas (pick one):
# mongodb+srv://user:pass@cluster.mongodb.net/school?retryWrites=true&w=majority
# If Node reports querySrv ECONNREFUSED, use Atlas "Drivers" → standard connection string (tls=true, all shard hosts).
MONGODB_URI=

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# One-time create first admin: POST /api/auth/bootstrap-admin
BOOTSTRAP_TOKEN=change-me-bootstrap

# Optional: encrypt ParentProfile.phone at rest (32-byte hex = 64 chars)
# PII_ENCRYPTION_KEY=

# Dummy data (after MONGODB_URI is set): npm run seed    |    reset all: npm run seed -- --reset
